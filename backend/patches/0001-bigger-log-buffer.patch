+// NewRecorderSize is NewRecorder with an explicit retention cap, for recorders
+// whose contents are exported as a support artifact rather than just shown in
+// the GUI's log view.
+func NewRecorderSize(level slog.Level, maxLines int) Recorder {
+	return &lineRecorder{level: level, maxLines: maxLines}
+}
+
