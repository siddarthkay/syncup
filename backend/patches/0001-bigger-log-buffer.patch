+	// maxLines is the retention cap; zero means maxLogLines.
+	maxLines int
+	mut      sync.Mutex
+	lines    []Line
 }
 
+func (r *lineRecorder) cap() int {
+	if r.maxLines > 0 {
+		return r.maxLines
+	}
+	return maxLogLines
+}
+
 func (r *lineRecorder) record(line Line) {
